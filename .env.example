# Copy to `.env` and edit. `.env` is gitignored.

# Session cookie signing secret. Generate: openssl rand -hex 32
# Rotating this invalidates all existing sessions (force logout).
SESSION_SECRET=change-me-to-64-hex-chars

# Seed first admin on cold start when admin_users table is empty.
# After first login you can change password from the UI, or add more admins
# via CLI: node cli.js add-admin new@example.com
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-this-in-production

# Set to `production` to enable Secure cookie flag (requires HTTPS).
NODE_ENV=development

# HTTP port
PORT=8787

# ---- Postgres ----
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Managed provider (Supabase/Neon/Railway): thường bắt buộc SSL → DATABASE_SSL=true
# Self-hosted không có TLS: DATABASE_SSL=false
DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_SSL=false

# ---- Cloudflare R2 (S3-compatible object storage) ----
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<from R2 → Manage API Tokens>
R2_SECRET_ACCESS_KEY=<from R2 → Manage API Tokens>
R2_BUCKET=<bucket-name>
# Public URL prefix:
#   Dev:        https://pub-<hash>.r2.dev  (bật ở bucket Settings → Public access)
#   Production: https://cdn.<your-domain>  (custom domain routed to R2)
R2_PUBLIC_BASE_URL=
